---
import type { Publication } from '../data/experience'

interface Props {
  publications: Publication[]
}
const { publications } = Astro.props

// "In press" gets the terra accent, published gets teal
function statusStyle(status: string): string {
  return /press|curso|progress/i.test(status)
    ? 'border:1px solid var(--terra); color:var(--terra); background:rgba(196,92,53,0.07);'
    : 'border:1px solid var(--teal); color:var(--teal2); background:rgba(45,123,120,0.07);'
}
---
<div class="publications" style="border-top:var(--brd); background:var(--s2); padding:28px 32px;">
  <div style="display:flex; align-items:center; gap:8px; margin-bottom:18px;">
    <span style="display:inline-block; width:7px; height:7px; background:#6b92ef;"></span>
    <span style="font-size:13px; letter-spacing:0.22em; text-transform:uppercase; color:var(--muted);">Publications</span>
  </div>
  <ul>
    {publications.map((pub, i) => (
      <li style={`display:flex; flex-direction:column; gap:6px; padding:16px 0; ${i > 0 ? 'border-top:var(--brd);' : ''}`}>
        <div style="font-size:14px; font-weight:500; color:var(--cream); line-height:1.4;">{pub.title}</div>
        <div style="display:flex; flex-wrap:wrap; align-items:center; gap:10px;">
          <span style="font-size:12px; letter-spacing:0.14em; text-transform:uppercase; color:var(--muted);">{pub.venue}</span>
          <span style={`font-size:11px; letter-spacing:0.1em; text-transform:uppercase; padding:2px 8px; ${statusStyle(pub.status)}`}>
            {pub.status}
          </span>
        </div>
      </li>
    ))}
  </ul>
</div>
